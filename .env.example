# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Optional server-side admin passcode override for /admin dashboard.
# Leave unset to claim the first-run admin password directly inside /admin.
ADMIN_PASSWORD=

# SESSION_SECRET: Optional signing secret for server-side admin sessions.
SESSION_SECRET=
